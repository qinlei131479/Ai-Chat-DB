# 服务名称
COMPOSE_PROJECT_NAME=aix-db

# 后端服务端口&工作线程（与项目根目录 .env 保持一致）
SERVER_PORT=8088
SERVER_WORKERS=1

# MinIO（本地开发无需文件上传时可关闭）
MINIO_ENABLED=false
MINIO_ENDPOINT=127.0.0.1:9000

# 应用数据库（本地开发默认值，容器内运行时会使用容器内 PostgreSQL）
SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/aix_db

# LangFuse 链路追踪（可选，默认关闭）
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# 前端 PageAgent 开关（运行时注入）
VITE_ENABLE_PAGE_AGENT=false

# 深度问数 LLM 模型最大长度
LLM_MAX_TOKENS=65536
